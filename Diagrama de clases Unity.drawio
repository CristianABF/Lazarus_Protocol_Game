<mxfile host="app.diagrams.net">
  <diagram name="Página-1" id="Bcby61Ppc5VKNsthqz6s">
    <mxGraphModel dx="6075" dy="3081" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction TB\n\n    %% ==========================================================\n    %% 1. INTERFACES, ENUMS Y ESTRUCTURAS DE DATOS\n    %% ==========================================================\n    class IPickable {\n        &lt;&lt;interface&gt;&gt;\n        +OnPickedUp() void\n        +OnDropped() void\n    }\n\n    class IEquipableUI {\n        &lt;&lt;interface&gt;&gt;\n        +GetTipoObjeto() TipoObjetoUI\n        +GetNombreObjeto() string\n        +GetMunicionActual() int\n        +GetMaxMunicion() int\n        +GetCargadores() int\n        +GetCantidadDisponible() int\n        +GetCantidadMaxima() int\n    }\n\n    class IDamageable {\n        &lt;&lt;interface&gt;&gt;\n        +TakeDamage(float amount) void\n    }\n\n    class TipoObjetoUI {\n        &lt;&lt;enumeration&gt;&gt;\n        Arma\n        Herramienta\n        Otro\n    }\n\n    class BuildableItem {\n        &lt;&lt;struct&gt;&gt;\n        +string id\n        +string itemName\n        +GameObject realPrefab\n        +GameObject hologramPrefab\n        +int maxAmount\n        +int stockDisponible\n        +int placedCount\n        +bool isUnlocked\n    }\n\n    class GamePhase {\n        &lt;&lt;struct&gt;&gt;\n        +string phaseName\n        +float phaseDuration\n        +float spawnInterval\n    }\n\n    class RecetaCrafteo {\n        &lt;&lt;ScriptableObject&gt;&gt;\n        +string idEnLlaveInglesa\n        +string nombreItem\n        +Sprite imagenPlano\n        +int costoChatarra\n        +GameObject prefabAEntregar\n    }\n\n    %% ==========================================================\n    %% 2. NÚCLEO GLOBAL, INPUT, OLEADAS Y TRUCOS\n    %% ==========================================================\n    class ControladorPartida {\n        &lt;&lt;Singleton&gt;&gt;\n        +ControladorPartida Instancia$\n        +Action~int~ OnEnemyKilled$\n        +float saludPermanenteNucleo\n        +float penalidadPorColapso\n        +int enemigosDerrotados\n        +float danoRecibidoTotal\n        +int creditosActuales\n        +float multiplicadorCreditos\n        +List~string~ mejorasCompradas\n        +float saludExtraJugador\n        +float velocidadCaminarExtra\n        +float velMaximaCaminarExtra\n        +float factorRecargaEstaciones\n        +int dañoExtraArma\n        +int balasExtraCargador\n        +float factorRecargaTorretas\n        +int cargadoresExtraMaximos\n        +float factorDañoTorretas\n        +RegistrarMejoraAdquirida(string nombreMejora) void\n        +RegistrarEnemigoDerrotado() void\n        +RegistrarDanoRecibido(float cantidad) void\n        +ProcesarDerrotaOleada() void\n        +LiquidarTiempoDeAsedio(float segundos) void\n        +AbrirTiendaMejoras() void\n        +EjecutarReinicioTactico() void\n        +RendirseYMostrarGameOver() void\n        +RegresarAlMenuPrincipal(string escena) void\n    }\n\n    class InputController {\n        &lt;&lt;Singleton&gt;&gt;\n        +InputManager Input$\n        -InputController Instancia$\n        -Awake() void\n        -OnDestroy() void\n    }\n\n    class WaveManager {\n        +Action~int~ OnPhaseStarted$\n        -TextMeshProUGUI timerText\n        -TextMeshProUGUI phaseText\n        -GameObject[] enemyPrefabs\n        -Transform[] spawnPoints\n        -GamePhase[] gamePhases\n        -float timeElapsed\n        -int currentPhaseIndex\n        -bool isWaveActive\n        -StartNextPhase() void\n        -SpawnEnemies(int count) void\n        -UpdateTimerUI() void\n    }\n\n    class CheatManager {\n        +bool municionInfinitaActiva$\n        -KeyCode[] codigoKonami\n        -bool trucosDesbloqueados\n        -EscucharCodigoKonami() void\n        -AdelantarTiempo() void\n        -ActivarModoDios() void\n        -AlternarMunicionInfinita() void\n    }\n\n    class GameFunctions {\n        &lt;&lt;static&gt;&gt;\n        +Attack(Component target, float damage)$ void\n    }\n\n    %% ==========================================================\n    %% 3. JUGADOR, INTERACCIÓN Y COMBATE\n    %% ==========================================================\n    class PlayerBehaviour {\n        &lt;&lt;externa&gt;&gt;\n        +float maxHealth\n        +float playerHealth\n        +RecibirDano(float cantidad) void\n        +RecibirCuracion(float cantidad) void\n    }\n\n    class InventarioJugador {\n        +int chatarraAcumulada\n        +SumarChatarra(int cantidad) void\n        +GastarChatarra(int cantidad) bool\n    }\n\n    class HoldObject {\n        -Transform holdPoint\n        -Animator animator\n        -float pickUpRange\n        -float throwForce\n        -GameObject heldObj\n        -Rigidbody heldObjRb\n        -TryPickUpObject() void\n        -DropObject() void\n        +GetHeldObject() GameObject\n        +ForzarAgarre(GameObject nuevoObjeto) void\n    }\n\n    class CharacterInteraction {\n        -Animator animator\n        -string interactTriggerName\n        +OnInteract(CallbackContext context) void\n        -TriggerInteraction() void\n    }\n\n    class WeaponIKGrip {\n        -Transform leftHandTarget\n        -Transform playerCamera\n        -Transform chestBone\n        -Transform cameraHolder\n        -Transform headPositionBone\n        +SetLeftHandTarget(Transform target) void\n        -OnAnimatorIK(int layerIndex) void\n    }\n\n    class Gun {\n        -string nombreArma\n        -float damage\n        -float fireRate\n        -bool isAutomatic\n        -float range\n        -GameObject bulletPrefab\n        +Camera fpsCam\n        -Ammo ammo\n        +OnPickedUp() void\n        +OnDropped() void\n        +Reload() void\n        +Animation_DetachMagazine() void\n        +Animation_AttachMagazine() void\n        +Animation_FinishReload() void\n        -IsShooting() void\n        -Recoil() void\n    }\n\n    class Ammo {\n        -int ammoAmount\n        -int reloadAmount\n        -int clips\n        -int maxClips\n        -int maxAmmo\n        +GetCurrentAmmo() int\n        +GetCurrentClips() int\n        +GetMaxAmmo() int\n        +GetMaxClips() int\n        +ReduceCurrentAmmo() void\n        +ExecuteReload() void\n        +RecibirCargadores(int cantidad) void\n    }\n\n    class Bullet {\n        -float speed\n        -float lifeTime\n        -float damage\n        -Transform owner\n        +Setup(float damageAmount, Transform bulletOwner) void\n    }\n\n    %% ==========================================================\n    %% 4. CONSTRUCCIÓN, TORRETAS, MINAS Y DEFENSAS\n    %% ==========================================================\n    class WrenchBuilder {\n        +List~BuildableItem~ buildableItems\n        -int currentIndex\n        -float buildRange\n        +Camera fpsCam\n        -GameObject currentHologram\n        -bool isEquipped\n        +OnPickedUp() void\n        +OnDropped() void\n        +UnlockItem(string id) void\n        +IncreaseMaxAmount(string id, int extra, int maxLimit) void\n        +PuedeFabricarDesdeWorkbench(string id) bool\n        +DesbloquearOAumentarDesdeWorkbench(string id, int extra) bool\n        -BuildObject() void\n        -UpdateHologram() void\n    }\n\n    class BuildingUnlockManager {\n        -WrenchBuilder wrenchBuilder\n        -PhaseUnlockCondition[] phaseUnlockConditions\n        -KillsUpgradeCondition[] killsUpgradeConditions\n        -EvaluatePhaseUnlocks(int currentPhase) void\n        -EvaluateKillsUpgrades(int currentKills) void\n    }\n\n    class BuildableObject {\n        +Action~BuildableObject~ OnObjectDestroyed\n        -OnDestroy() void\n    }\n\n    class BarricadeObstacle {\n        -float lifetime\n        -NavMeshObstacle navObstacle\n        +Action~BarricadeObstacle~ OnDestroyed\n        +OnPlaced() void\n        -RecalculateNearbyEnemies() void\n    }\n\n    class TurretBase {\n        &lt;&lt;abstract&gt;&gt;\n        #Transform turretHead\n        #Transform firePoint\n        #LayerMask enemyLayer\n        #float range\n        #float rotationSpeed\n        #float fireRate\n        #float duracionDeVida\n        #Transform target\n        #UpdateTarget() void\n        #LockOnTarget() void\n        #Attack()* void\n    }\n\n    class MachineGunTurret {\n        -float damage\n        -GameObject bulletPrefab\n        #Start() void\n        #Attack() void\n    }\n\n    class SniperTurret {\n        -float highDamage\n        -GameObject bulletPrefab\n        #Start() void\n        #Attack() void\n    }\n\n    class FlamethrowerTurret {\n        -float continuousDamagePerSecond\n        -ParticleSystem flameParticles\n        #Start() void\n        #Update() void\n        #Attack() void\n    }\n\n    class Landmine {\n        &lt;&lt;abstract&gt;&gt;\n        #float triggerRadius\n        #LayerMask enemyLayer\n        #GameObject explosionEffect\n        #AudioClip soundEffect\n        #bool isTriggered\n        #OnDetonate(GameObject target)* void\n    }\n\n    class ExplosiveMine {\n        -float damage\n        -float explosionRadius\n        -float vfxLifetime\n        #OnDetonate(GameObject target) void\n    }\n\n    class ElectricMine {\n        -float totalDamage\n        -float stunRadius\n        -float timeBetweenTicks\n        #OnDetonate(GameObject target) void\n        -ElectricAoERoutine() IEnumerator\n    }\n\n    %% ==========================================================\n    %% 5. ENEMIGOS Y NÚCLEO DE LA NAVE\n    %% ==========================================================\n    class CoreBehaviour {\n        +float maxHealth\n        +float currentHealth\n        -bool isDestroyed\n        -int maxAttackers\n        -List~Transform~ currentAttackers\n        +SolicitarnLugarParaAtacar(Transform enemigo) bool\n        +LiberarLugar(Transform enemigo) void\n        +RecibirDaño(float amount) void\n        -VerificarUmbralesSalud() void\n        -ColapsoInminente() void\n    }\n\n    class EnemyAI {\n        -TargetType enemyType\n        -float chaseRange\n        -float attackDistance\n        -float damage\n        -List~Transform~ patrolZones\n        -NavMeshAgent navMeshAgent\n        -bool isProvoked\n        -bool isStunned\n        -CoreBehaviour coreScript\n        +OnDamageTaken(Transform attacker) void\n        +TargetDetected() void\n        +SetStunned(bool state) void\n        +RandomNavSphere(Vector3 origin, float dist, int mask)$ Vector3\n        -PatrullarYMerodear() void\n        -AplicarDañoAlObjetivo() void\n    }\n\n    class EnemyHealth {\n        &lt;&lt;externa&gt;&gt;\n        +float health\n        +float maxHealth\n        -bool isDead\n        +TakeDamage(float amount) void\n        -Morir() void\n    }\n\n    class SpawnTrigger {\n        -GameObject enemyPrefab\n        -Transform enemySpawnPoint\n        -OnTriggerEnter(Collider other) void\n    }\n\n    %% ==========================================================\n    %% 6. ENTORNO E INTERACTUABLES\n    %% ==========================================================\n    class EstacionCuracion {\n        +float capacidadMaxima\n        +float cantidadPorInteraccion\n        +float tiempoRecarga\n        -float capacidadActual\n        -bool estaActiva\n        -PlayerBehaviour scriptJugador\n        -IntentarCuracion() void\n    }\n\n    class CajaMunicion {\n        +int capacidadCargadores\n        +int cargadoresPorInteraccion\n        +float tiempoRecarga\n        +TMP_Text textoBarraRecarga\n        -int capacidadActual\n        -IntentarSuministro() void\n        -ActualizarBarraVisual(float porcentaje) void\n    }\n\n    class WorkbenchController {\n        +KeyCode teclaInteractuar\n        +float distanciaInteraccion\n        +GameObject panelMenuWorkbench\n        -bool estaAbierto\n        +AbrirMenu() void\n        +CerrarMenu() void\n    }\n\n    class WorkbenchUI {\n        +List~RecetaCrafteo~ recetas\n        +WrenchBuilder llaveInglesa\n        -int indiceActual\n        -InventarioJugador inventario\n        +ActualizarPantalla() void\n        +SiguienteReceta() void\n        +AnteriorReceta() void\n        +FabricarItem() void\n    }\n\n    class ChatarraRecoleccion {\n        +int valorChatarra\n        +float velocidadRotacion\n        -OnTriggerEnter(Collider other) void\n    }\n\n    class PuertaCorrediza {\n        +bool estaRota\n        +bool estaFallando\n        +Transform puertaIzquierda\n        +Transform puertaDerecha\n        +float danoPorAplastamiento\n        +float cooldownDano\n        -bool estaAbierta\n    }\n\n    class TrampaAplastamiento {\n        -PuertaCorrediza puertaPadre\n        -OnTriggerStay(Collider other) void\n    }\n\n    %% ==========================================================\n    %% 7. INTERFAZ, MENÚS, TIENDA Y PERSISTENCIA\n    %% ==========================================================\n    class HoldObjectUI {\n        -GameObject panelArma\n        -GameObject panelHerramienta\n        -HoldObject holdObjectScript\n        -ActualizarPantalla(IEquipableUI equipable) void\n        +OcultarTodo() void\n    }\n\n    class MirarObjetoAyuda {\n        -float distanciaRaycast\n        -GameObject burbujaAyudaUI\n        -Update() void\n    }\n\n    class PlayerHealthBar {\n        &lt;&lt;externa&gt;&gt;\n        +SetHUDVisible(bool visible) void\n    }\n\n    class EnlazadorUI {\n        +GameObject panelLazaroNuevo\n        +GameObject panelGameOverNuevo\n        +GameObject panelMejorasNuevo\n        +PlayerHealthBar hudSalud\n        +Button btnActivarLazaro\n        +Button btnRendirse\n        +Button btnComenzarAsedio\n        +Button btnVolverMenu\n        +OcultarHUDVida() void\n    }\n\n    class VisorTienda {\n        +TextMeshProUGUI textoTitulo\n        +TextMeshProUGUI textoDescripcion\n        +TextMeshProUGUI textoSaldoBilletera\n        -NodoHabilidad nodoSeleccionado\n        +MostrarDetalles(NodoHabilidad nodo) void\n        +IntentarCompra() void\n        -ActualizarPantalla() void\n    }\n\n    class NodoHabilidad {\n        +string tituloMejora\n        +string descripcionTecnica\n        +int costoPuntos\n        +bool estaDesbloqueado\n        +NodoHabilidad nodoRequisito\n        +TextMeshProUGUI textoDelBoton\n        -VisorTienda visor\n        +MarcarComoComprado() void\n        -EnviarDatosAlVisor() void\n    }\n\n    class PauseControl {\n        +bool isPaused$\n        +GameObject pauseMenuUI\n        +GameObject listaBotones\n        +GameObject panelGuardar\n        +GameObject panelAjustes\n        +Resume() void\n        +AbrirGuardar() void\n        +AbrirAjustes() void\n        +VolverMenuPausa() void\n        +IrMenuPrincipal(string escena) void\n        +SalirJuego() void\n    }\n\n    class MainMenuInit {\n        +GameObject listaBotonesPrincipal\n        +GameObject panelAjustes\n        +GameObject panelCargar\n        -Start() void\n        -Update() void\n    }\n\n    class SwapScene {\n        +CargarEscena(string nombreDeLaEscena) void\n        +SalirDelJuego() void\n    }\n\n    class ButtonEffect {\n        -float normalScale\n        -float hoverScale\n        -float clickScale\n        +OnPointerEnter(PointerEventData) void\n        +OnPointerExit(PointerEventData) void\n        +OnPointerDown(PointerEventData) void\n        +OnPointerUp(PointerEventData) void\n    }\n\n    class AjustesManager {\n        +AudioMixer audioMixer\n        +Volume volumenPostProcesado\n        -int volMaestro\n        -int volMusica\n        -int volEfectos\n        -int resIndex\n        -int refrescoIndex\n        -int brillo\n        -int sensibilidad\n        -bool invertirY\n        +CargarAjustes() void\n        +ClicMaestroMas() void\n        +ClicMusicaMas() void\n        +ClicEfectosMas() void\n        +ClicResolucion() void\n        +ClicRefresco() void\n        +ClicBrilloMas() void\n        +ClicSensibilidadMas() void\n        +ClicInvertirY() void\n    }\n\n    class GuardarManager {\n        +bool enDescanso$\n        +TextMeshProUGUI textoSlot1\n        +TextMeshProUGUI textoSlot2\n        +TextMeshProUGUI textoSlot3\n        +Transform transformJugador\n        +HoldObject scriptAgarre\n        +SeleccionarSlot(int numeroSlot) void\n        +ClicGuardarPartida() void\n        -ActualizarPantalla() void\n    }\n\n    class CargarManager {\n        +TextMeshProUGUI textoSlot1\n        +TextMeshProUGUI textoSlot2\n        +TextMeshProUGUI textoSlot3\n        +string nombreEscenaJuego\n        +SeleccionarSlot(int numeroSlot) void\n        +ClicCargarPartida() void\n        +ClicNuevaPartida() void\n    }\n\n    class MotorCargaNivel {\n        +GameObject jugador\n        +HoldObject scriptAgarre\n        -Start() void\n        -CargarDatosFisicos(int slot) void\n    }\n\n    %% ==========================================================\n    %% RELACIONES DE HERENCIA E IMPLEMENTACIÓN\n    %% ==========================================================\n    IPickable &lt;|.. Gun\n    IEquipableUI &lt;|.. Gun\n    IPickable &lt;|.. WrenchBuilder\n    IEquipableUI &lt;|.. WrenchBuilder\n    IDamageable &lt;|.. EnemyHealth\n\n    TurretBase &lt;|-- MachineGunTurret\n    TurretBase &lt;|-- SniperTurret\n    TurretBase &lt;|-- FlamethrowerTurret\n\n    Landmine &lt;|-- ExplosiveMine\n    Landmine &lt;|-- ElectricMine\n\n    %% ==========================================================\n    %% COMPOSICIÓN, ASOCIACIÓN Y DEPENDENCIAS\n    %% ==========================================================\n    WaveManager *-- GamePhase\n    WaveManager ..&gt; GuardarManager : activa enDescanso\n\n    WrenchBuilder *-- BuildableItem\n    WrenchBuilder ..&gt; BuildableObject : crea/escucha\n    WrenchBuilder ..&gt; BarricadeObstacle : llama OnPlaced\n    WrenchBuilder ..&gt; InputController : lee inputs\n    WrenchBuilder ..&gt; PauseControl : valida isPaused\n\n    BuildingUnlockManager --&gt; WrenchBuilder : desbloquea/mejora\n    BuildingUnlockManager ..&gt; WaveManager : suscribe OnPhaseStarted\n    BuildingUnlockManager ..&gt; ControladorPartida : suscribe OnEnemyKilled\n\n    HoldObject ..&gt; IPickable : notifica agarre/suelta\n    HoldObject ..&gt; InputController : lee Pick\n    HoldObjectUI --&gt; HoldObject : consulta objeto en mano\n    HoldObjectUI ..&gt; IEquipableUI : dibuja HUD\n    IEquipableUI ..&gt; TipoObjetoUI\n\n    Gun --&gt; Ammo : consume/recarga\n    Gun ..&gt; Bullet : instancia\n    Gun ..&gt; ControladorPartida : lee dañoExtraArma\n    Gun ..&gt; InputController : lee Shoot\n    Gun ..&gt; PauseControl : valida isPaused\n    Ammo ..&gt; ControladorPartida : lee balasExtraCargador\n    Ammo ..&gt; CheatManager : consulta municionInfinita\n\n    Bullet ..&gt; IDamageable : daña\n    Bullet ..&gt; EnemyAI : notifica OnDamageTaken\n    Bullet ..&gt; GameFunctions : delega ataque\n\n    TurretBase ..&gt; ControladorPartida : lee factorRecargaTorretas\n    MachineGunTurret ..&gt; Bullet : instancia\n    SniperTurret ..&gt; Bullet : instancia\n    FlamethrowerTurret ..&gt; IDamageable : daña\n    FlamethrowerTurret ..&gt; EnemyAI : notifica agro\n    ExplosiveMine ..&gt; EnemyHealth : daña en área\n    ElectricMine ..&gt; EnemyHealth : daña por ticks\n    ElectricMine ..&gt; EnemyAI : aplica Stun\n\n    EnemyAI --&gt; CoreBehaviour : solicita/libera cupo y daña\n    EnemyAI ..&gt; PlayerBehaviour : daña\n    EnemyHealth ..&gt; EnemyAI : activa agro\n    EnemyHealth ..&gt; ControladorPartida : registra baja\n    CoreBehaviour ..&gt; ControladorPartida : dispara derrota\n\n    EstacionCuracion --&gt; PlayerBehaviour : cura\n    CajaMunicion ..&gt; Ammo : suministra cargadores\n    WorkbenchUI --&gt; RecetaCrafteo : lista recetas\n    WorkbenchUI --&gt; InventarioJugador : gasta chatarra\n    WorkbenchUI --&gt; WrenchBuilder : fabrica/desbloquea\n    ChatarraRecoleccion ..&gt; InventarioJugador : suma chatarra\n    TrampaAplastamiento --&gt; PuertaCorrediza : consulta fallo/cooldown\n    TrampaAplastamiento ..&gt; PlayerBehaviour : daña\n    TrampaAplastamiento ..&gt; EnemyHealth : daña\n\n    EnlazadorUI --&gt; ControladorPartida : reconecta paneles y botones\n    EnlazadorUI --&gt; PlayerHealthBar : oculta HUD\n    VisorTienda --&gt; NodoHabilidad : muestra/compra\n    VisorTienda ..&gt; ControladorPartida : cobra y registra mejora\n    NodoHabilidad --&gt; VisorTienda : envía detalles\n    NodoHabilidad --&gt; NodoHabilidad : nodoRequisito\n    NodoHabilidad ..&gt; ControladorPartida : verifica mejorasCompradas\n\n    MainMenuInit ..&gt; PauseControl : resetea isPaused\n    SwapScene ..&gt; PauseControl : resetea isPaused\n    GuardarManager --&gt; HoldObject : lee objeto en mano\n    GuardarManager ..&gt; ControladorPartida : guarda salud y chatarra\n    MotorCargaNivel --&gt; HoldObject : llama ForzarAgarre\n    MotorCargaNivel ..&gt; ControladorPartida : restaura chatarra\n    CheatManager ..&gt; ControladorPartida : suma créditos\n    CheatManager ..&gt; PlayerBehaviour : modo dios\n    CheatManager ..&gt; CoreBehaviour : modo dios&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="zfIuhf9D-XSbSBMq5QrZ-608">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;IPickable&lt;/b&gt;" mermaidId="n:IPickable" mermaidBaseStyle="swimlane;html=1;fontStyle=1;fontSize=16;align=center;verticalAlign=middle;horizontal=1;childLayout=stackLayout;startSize=66;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginTop=12;marginBottom=12;stackSpacing=0;swimlaneFillColor=#FDF4FF;whiteSpace=wrap;spacingTop=24;fillColor=#FDF4FF;strokeColor=#E879F9;fontColor=#28253D;fontFamily=Recursive;strokeWidth=2;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;" mermaidBaseValue="&lt;b&gt;IPickable&lt;/b&gt;" id="zfIuhf9D-XSbSBMq5QrZ-609">
          <mxCell parent="zfIuhf9D-XSbSBMq5QrZ-608" style="swimlane;html=1;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;horizontal=1;childLayout=stackLayout;startSize=66;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginTop=12;marginBottom=12;stackSpacing=0;swimlaneFillColor=#FDF4FF;whiteSpace=wrap;spacingTop=24;fillColor=#FDF4FF;strokeColor=#E879F9;fontColor=#28253D;fontFamily=Recursive;strokeWidth=2;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;" vertex="1">
            <mxGeometry height="114" width="199" x="3022" y="2418" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="zfIuhf9D-XSbSBMq5QrZ-610" parent="zfIuhf9D-XSbSBMq5QrZ-609" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;movable=0;resizable=0;rotatable=0;points=[];fontFamily=Recursive;fontColor=#28253D;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;" value="«interface»" vertex="1">
          <mxGeometry height="24" width="199" y="12" as="geometry" />
        </mxCell>
        <mxCell id="zfIuhf9D-XSbSBMq5QrZ-611" parent="zfIuhf9D-XSbSBMq5QrZ-609" style="line;strokeWidth=2;fillColor=none;spacingLeft=3;spacingRight=3;rotatable=0;points=[];strokeColor=inherit;" vertex="1">
          <mxGeometry height="24" width="199" y="36" as="geometry" />
        </mxCell>
        <mxCell id="zfIuhf9D-XSbSBMq5QrZ-612" parent="zfIuhf9D-XSbSBMq5QrZ-609" style="text;fontSize=14;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=12;spacingBottom=2;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontFamily=Recursive;fontColor=#28253D;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;" value="+OnPickedUp() void" vertex="1">
